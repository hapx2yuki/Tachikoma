# ---- 環境・ビルド産物 (すべて再生成可能) ----
.venv/
firmware/.pio/
__pycache__/
*.pyc
.DS_Store
.claude/

# ---- URDF スナップショット (hardware/urdf/ が最新。tools/export_urdf.py で再生成可能) ----
tachikoma_urdf_*/
tachikoma_urdf_*.zip

# ---- ローカル秘密 (APIキー等は環境変数/.env 運用 — コミット禁止) ----
.env
.env.*
credentials.json
token.json
*.pem
*.key

# ---- 監査の再生成可能キャッシュ (分割条件のJSONは保存) ----
docs/audits/**/collision-cache/*.npz

# ---- 内部参照用のメーカー原本・原形状コピー (出典/測定値は保存) ----
docs/audits/20260905-round2/primary-sources/*.pdf
docs/audits/20260905-round2/primary-sources/*.png
docs/audits/20260905-round2/primary-sources/*.zip
